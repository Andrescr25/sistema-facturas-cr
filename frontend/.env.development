# Rama independencia-alegra: corre aparte de developer.
#   developer             → frontend 5173, backend 3000 (base de producción)
#   independencia-alegra  → frontend 5174, backend 3001 (copia local)
#
# Este archivo gana sobre .env y .env.local en `npm run dev`, así que la rama
# nunca termina hablando con el backend de developer por un .env.local viejo.
# No aplica a `npm run build`. Se borra el día del corte.
PUERTO_FRONTEND=5174
VITE_API_URL=http://localhost:3001
