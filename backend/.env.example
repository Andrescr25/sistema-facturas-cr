# Base de Datos PostgreSQL
# IMPORTANTE PARA SUPABASE: Usar la URL del Pooler (puerto 6543) NO la directa (puerto 5432)
# El pooler permite múltiples conexiones simultáneas en el free tier
# Ejemplo Supabase: postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://usuario:password@localhost:5432/nombre_bd"

# Alegra API
ALEGRA_USER="tu_email@gmail.com"
ALEGRA_TOKEN="tu_token_de_alegra"

# Email (opcional - para recepciÃ³n automÃ¡tica de facturas)
IMAP_USER="tu_email@gmail.com"
IMAP_PASSWORD="tu_password_de_app"
IMAP_HOST="imap.gmail.com"
IMAP_PORT=993
IMAP_TLS=true

# Servidor
PORT=3000
NODE_ENV=development

# Frontend URL (para CORS)
FRONTEND_URL="http://localhost:5173"
